{
  "name": "plantilladocumentacion",
  "version": "1.6.1",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js --env prod",
    "start:dev": "node --watch src/app.js --env dev",
    "start:test": "node src/app.js --env test",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha 'test/unit/**/*.test.js' --env test",
    "test:integration": "mocha --require ./test/helpers/server.js 'test/integration/**/*.test.js' --env test",
    "test:coverage": "c8 --reporter=text --reporter=html --all npm run test",
    "pm2": "pm2 start src/app.js -i max -f"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "bcrypt": "^5.1.0",
    "commander": "^15.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.7.5",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.1"
